# ============================================================
#  AI Laptop Assistant — Environment Configuration Template
#  Copy this file to .env and fill in your values
# ============================================================

# OpenAI API Key (Paid) - https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenAI Model to use (Options: gpt-3.5-turbo, gpt-4, gpt-4o, gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Google Gemini API Key (FREE) - https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Groq API Key (FREE Llama 3) - https://console.groq.com/keys
GROQ_API_KEY=

# Maximum tokens per AI response
MAX_TOKENS=1024

# Temperature for AI creativity (0.0 = strict, 1.0 = creative)
TEMPERATURE=0.7

# Text-to-Speech settings
TTS_RATE=175          # Words per minute (default: 175)
TTS_VOLUME=0.9        # Volume 0.0 to 1.0

# Voice input settings
VOICE_TIMEOUT=5       # Seconds to wait for voice input
VOICE_PHRASE_LIMIT=10 # Max seconds per phrase

# Application paths (leave blank to use system defaults)
CHROME_PATH=
VSCODE_PATH=
